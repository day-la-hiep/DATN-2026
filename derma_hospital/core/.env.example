# Sao chép thành .env rồi chỉnh cho phù hợp môi trường.
# Giá trị mặc định khớp với docker-compose.yml ở gốc repo (postgres/redis/rabbitmq/
# qdrant/neo4j) và app/core/config.py — không cần chỉnh gì để chạy dev, trừ
# OPENROUTER_API_KEY và MinIO (xem ghi chú bên dưới).

PROJECT_NAME=Derma AI Backend
DEBUG=false

# ----- PostgreSQL (SQLAlchemy async engine, driver asyncpg) -----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/derma_hospital_db

# ----- Redis (Pub/Sub) -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ----- RabbitMQ -----
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ----- Qdrant (vector DB) -----
QDRANT_URL=http://localhost:6333
# Long-term memory: hạ tầng cũ (app/kien-truc-memory.md), hiện KHÔNG được dùng nữa —
# app/agent/memory.py đã chuyển sang langgraph.store.InMemoryStore. Giữ lại để không
# phá .env hiện có.
QDRANT_COLLECTION=agent_memories
# Knowledge base guideline (BYT 75/2015, WHO, MedlinePlus) — ingest qua
# scripts/ingest/ingest_knowledge_base.py, dùng bởi
# app/agent/tools/knowledge_base_search.py.
QDRANT_KB_COLLECTION=derma_kb_chunks

# ----- Neo4j (knowledge graph da liễu — PrimeKG, xem
# app/agent/tools/knowledge_graph.py + data/PrimeKG/load_to_neo4j.py) -----
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=derma12345

# ----- MinIO (object storage — ảnh đính kèm tin nhắn, app/infra/file_storage.py) -----
# Dùng cho tool app/agent/tools/skin_image_classifier.py. Giá trị mặc định khớp
# instance MinIO có sẵn trên máy dev (KHÔNG nằm trong docker-compose.yml của repo này
# — xem ghi chú trong file đó) — chỉnh lại nếu máy bạn dùng instance/credential khác.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=derma-attachments
MINIO_SECURE=false

# ----- CORS (JSON array) -----
CORS_ORIGINS=["*"]

# ----- Agent (LangChain / LangGraph) -----
# Cú pháp "provider:model". "openai:..." = OpenRouter (API tương thích OpenAI, xem
# app/agent/llm.py + OPENROUTER_* bên dưới) — cần package "langchain-openai" (đã có
# trong pyproject.toml). Embeddings (memory.py, knowledge_base_search.py) chạy LOCAL
# (app/agent/embeddings.py, sentence-transformers) — KHÔNG cần Google/bất kỳ API key
# nào nữa. Muốn quay lại Gemini trực tiếp cho AGENT_MODEL: đặt
# AGENT_MODEL=google_genai:gemini-3.5-flash-lite + GOOGLE_API_KEY=...
AGENT_MODEL=openai:google/gemma-4-26b-a4b-it
AGENT_TEMPERATURE=0.3
AGENT_THINKING_LEVEL=medium

# ----- OpenRouter (dùng khi AGENT_MODEL provider = "openai", xem trên) -----
# Lấy API key tại https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# TTL (giây) cho Redis key `agent:pending_turn:*`/`agent:active_turn:*` — xem
# app/core/config.py.
AGENT_TURN_KEY_TTL=60

# ----- Skin CNN classifier (app/agent/tools/skin_image_classifier.py) -----
# Mặc định tự trỏ tới ../model/model_output/AdaptiveCNN_SkinDisease_v5_best.pth
# (sibling repo root) — chỉ cần set nếu checkpoint đặt nơi khác.
# SKIN_CNN_CHECKPOINT_PATH=

# ----- Shared-token auth (bảo vệ bản demo khi deploy cho người ngoài test — app/core/auth.py) -----
# Rỗng = tắt (mặc định dev). Set 1 chuỗi random để bật — mọi request API (trừ /health)
# phải kèm header `Authorization: Bearer <token>`. Gợi ý tạo: python3 -c "import
# secrets; print(secrets.token_urlsafe(24))"
APP_ACCESS_TOKEN=
