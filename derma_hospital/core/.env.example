# Sao chép thành .env rồi chỉnh cho phù hợp môi trường.
# Giá trị mặc định khớp với docker-compose.yml ở gốc repo (postgres/redis/rabbitmq).

PROJECT_NAME=Derma AI Backend
DEBUG=false

# ----- PostgreSQL (SQLAlchemy async engine, driver asyncpg) -----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/derma_hospital_db

# ----- Redis (Pub/Sub) -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ----- RabbitMQ -----
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ----- Qdrant (long-term memory — vector DB, xem app/agent/memory.py) -----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=agent_memories

# ----- CORS (JSON array) -----
CORS_ORIGINS=["*"]

# ----- Agent (LangChain / LangGraph) -----
# Cú pháp "provider:model". Provider "google_genai" cần package
# "langchain[google-genai]" (đã có trong pyproject.toml) + GOOGLE_API_KEY.
AGENT_MODEL=google_genai:gemini-3.5-flash-lite
AGENT_TEMPERATURE=0.3
AGENT_MAX_REASONING_STEPS=4
GOOGLE_API_KEY=
