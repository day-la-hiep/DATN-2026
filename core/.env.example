# Sao chép thành .env rồi chỉnh cho phù hợp môi trường.
# Giá trị mặc định khớp với docker-compose.yml ở gốc repo (postgres/redis/rabbitmq/
# qdrant/neo4j) và app/config/settings.py — không cần chỉnh gì để chạy dev, trừ
# OPENROUTER_API_KEY và MinIO (xem ghi chú bên dưới).

PROJECT_NAME=Derma AI Backend
DEBUG=false

# ----- PostgreSQL (SQLAlchemy async engine, driver asyncpg) -----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/derma_hospital_db
# DATABASE_POOL_PRE_PING=true      # ping kết nối trước khi lấy từ pool
# DATABASE_EXPIRE_ON_COMMIT=false
# DATABASE_AUTOFLUSH=false

# ----- Redis (Pub/Sub) -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ----- RabbitMQ -----
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ----- Qdrant (vector DB) -----
QDRANT_URL=http://localhost:6333
# Khớp QDRANT__SERVICE__API_KEY trong docker-compose.yml (để trống nếu Qdrant không bật auth).
QDRANT_API_KEY=derma_qdrant_2026
# Collection sách cũ (payload book_id/book_title), agent đọc thêm bên cạnh derma_document_chunks_v4 (không có sparse bm25 nên chỉ dùng cho semantic); để trống nếu không còn.
QDRANT_LEGACY_BOOK_COLLECTION=derma_book_chunks

# ----- Neo4j (knowledge graph da liễu — PrimeKG + DermO, xem
# app/infra/neo4j_client.py + data_ingest/01_normalize/scripts/load_primekg.py, load_dermo.py) -----
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=derma12345

# ----- MinIO (object storage — ảnh đính kèm tin nhắn, app/infra/file_storage.py) -----
# Dùng cho tool app/agent/tools/skin_image_classifier.py. Giá trị mặc định khớp
# instance MinIO có sẵn trên máy dev (KHÔNG nằm trong docker-compose.yml của repo này
# — xem ghi chú trong file đó) — chỉnh lại nếu máy bạn dùng instance/credential khác.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=derma-attachments
MINIO_SECURE=false

# ----- CORS (JSON array) -----
CORS_ORIGINS=["*"]

# ----- Agent (LangChain / LangGraph) -----
# Cú pháp "provider:model". "openai:..." = OpenRouter (API tương thích OpenAI, xem
# app/agent/llm.py + OPENROUTER_* bên dưới) — cần package "langchain-openai" (đã có
# trong pyproject.toml). Embedding + reranker (Qwen3) cũng gọi qua OpenRouter, dùng chung
# OPENROUTER_API_KEY (xem EMBEDDING_MODEL / RERANKER_MODEL trong app/config/settings.py). Muốn quay lại Gemini trực tiếp cho AGENT_MODEL: đặt
# AGENT_MODEL=google_genai:gemini-3.5-flash-lite + GOOGLE_API_KEY=...
AGENT_MODEL=openai:google/gemma-4-26b-a4b-it
AGENT_TEMPERATURE=0.3
AGENT_THINKING_LEVEL=medium
# Bước lọc intent trước lập luận chính (chào hỏi / cảm ơn / ngoài phạm vi thì trả lời luôn).
# AGENT_TRIAGE_MODEL dạng "provider:model", để trống = dùng model của hội thoại.
AGENT_TRIAGE_ENABLED=true
AGENT_TRIAGE_MODEL=

# ----- OpenRouter (dùng khi AGENT_MODEL provider = "openai", xem trên) -----
# Lấy API key tại https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# ----- LangSmith (trace mọi lệnh gọi LLM/tool trong agent_graph — xem
# https://smith.langchain.com) -----
# Rỗng/false = tắt hoàn toàn (mặc định, không tốn gì). Lấy API key tại
# https://smith.langchain.com/settings — LangChain tự đọc thẳng các biến này từ môi
# trường, không cần code gì thêm để bật (app/config/settings.py::log_startup_infra chỉ đọc
# lại LANGSMITH_TRACING/LANGSMITH_PROJECT để log trạng thái lúc khởi động).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=derma-hospital
# Chỉ cần đổi nếu dùng LangSmith self-hosted/proxy riêng — bỏ trống dùng mặc định
# (https://api.smith.langchain.com).
# LANGSMITH_ENDPOINT=

# TTL (giây) cho Redis key `agent:pending_turn:*`/`agent:active_turn:*` — xem
# app/config/settings.py.
AGENT_TURN_KEY_TTL=60

# ----- Skin CNN classifier (app/agent/tools/skin_image_classifier.py) -----
# Mặc định tự trỏ tới ../model/model_output/AdaptiveCNN_SkinDisease_v5_best.pth
# (sibling repo root) — chỉ cần set nếu checkpoint đặt nơi khác.
# SKIN_CNN_CHECKPOINT_PATH=

# ----- Web search nguồn uy tín (agent/tools/web_search.py) -----
# Lấy key tại https://app.tavily.com — rỗng = tool web tắt.
TAVILY_API_KEY=

# Mức log toàn hệ thống (DEBUG/INFO/WARNING/ERROR); NO_COLOR=1 tắt màu, FORCE_COLOR=1 ép bật
LOG_LEVEL=INFO
