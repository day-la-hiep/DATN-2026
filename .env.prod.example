# Dùng cho docker-compose.prod.yml — copy thành `.env` (CÙNG thư mục file compose này)
# rồi điền giá trị THẬT (khác default dev, đây là các mật khẩu hạ tầng chạy trong
# Docker network riêng, không cần nhớ, chỉ cần random đủ dài).
#
# Sinh nhanh 1 giá trị random: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#
# Lưu ý: các biến app-level thật sự (OPENROUTER_API_KEY, APP_ACCESS_TOKEN, AGENT_MODEL...)
# nằm ở `core/.env` (copy từ `core/.env.example`), KHÔNG phải file này — file này chỉ
# cho biến hạ tầng compose cần để dựng container. Tunnel/reverse-proxy (Cloudflare
# Tunnel hay khác) tự cấu hình riêng, trỏ vào port 3000 của service `fe` (đã publish ra
# host, xem docker-compose.prod.yml).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=derma_hospital_db

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=

NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio
